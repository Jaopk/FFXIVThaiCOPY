<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">

	<PropertyGroup>
		<Version>1.9.4.0</Version>
		<IsPackable>false</IsPackable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Configurations>Debug;Release</Configurations>
		<Platforms>x64</Platforms>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="images/icon.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		
			<Content Include="THSarabunNew-Bold.ttf">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		
		<Content Include="../content/thai_dict.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>

		<!-- ต้องลงใน content/ เพราะ DialogueDictionary.LoadAlignmentMap อ่านจาก <plugin>/content/alignment.json
		     ถ้าวางผิดที่มันจะ return เงียบ ๆ โดยไม่ log อะไรเลย -->
		<Content Include="../content/alignment.json">
			<Link>content/alignment.json</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>

		<!-- ทุกโฟลเดอร์แพตช์ใต้ content/ (2.0, 2.x ... 7.56) แพตช์ใหม่จะติดมาเองโดยไม่ต้องแก้ไฟล์นี้
		     ไม่กิน alignment.json ที่อยู่ระดับบนสุด เพราะ include แยกไว้ข้างบนแล้ว -->
		<Content Include="../content/*/**/*.json">
			<Link>content/%(RecursiveDir)%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<Target Name="CopyZipToRelease" AfterTargets="Build;ZipPluginBundle">
		<Copy SourceFiles="$(OutDir)ffxiv-msq-thai/latest.zip" DestinationFiles="$(MSBuildProjectDirectory)/../release/latest.zip" SkipUnchangedFiles="true" Condition="'$(Configuration)' == 'Release' And Exists('$(OutDir)ffxiv-msq-thai/latest.zip')" />
	</Target>

</Project>
